# ==========================================
# Environments & Secrets (CRITICAL)
# ==========================================
.env
.venv
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert

# ==========================================
# Python & FastAPI
# ==========================================
